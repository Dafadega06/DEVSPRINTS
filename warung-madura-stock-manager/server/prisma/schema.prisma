generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockMovementType {
  INITIAL
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESTOCK
  RESTOCK_BONUS
  DAMAGED_IN
  OPNAME_IN
  OPNAME_OUT
}

enum RestockOrderStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

enum RestockItemStatus {
  PENDING
  PARTIAL
  FULFILLED
  CANCELLED
}

enum InventoryCheckStatus {
  DRAFT
  COMPLETED
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  sku           String   @unique
  name          String
  category      String
  purchasePrice Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  stock         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  unitName      String   @default("pcs")
  bulkUnitName  String?  
  piecesPerBulk Int?     

  saleItems           SaleItem[]
  stockMovements      StockMovement[]
  restockOrderItems   RestockOrderItem[]
  restockReceiptItems RestockReceiptItem[]
  inventoryCheckItems InventoryCheckItem[]
}

model Sale {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceNumber String   @unique
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  items SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  productId     String            @db.Uuid
  type          StockMovementType
  quantity      Int
  beforeStock   Int
  afterStock    Int
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restockOrders RestockOrder[]
}

model RestockOrder {
  id          String             @id @default(uuid()) @db.Uuid
  orderNumber String             @unique
  supplierId  String             @db.Uuid
  status      RestockOrderStatus @default(PENDING)
  notes       String?
  orderedAt   DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    RestockOrderItem[]
  receipts RestockReceipt[]

  @@index([supplierId])
  @@index([orderedAt])
}

model RestockOrderItem {
  id               String           @id @default(uuid()) @db.Uuid
  restockOrderId   String           @db.Uuid
  productId        String           @db.Uuid
  quantityOrdered  Int
  quantityReceived Int              @default(0)
  unitName         String
  piecesPerUnit    Int
  purchasePrice    Decimal          @db.Decimal(12, 2)
  status           RestockItemStatus @default(PENDING)

  restockOrder RestockOrder         @relation(fields: [restockOrderId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems RestockReceiptItem[]

  @@index([restockOrderId])
  @@index([productId])
}

model RestockReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptNumber   String   @unique
  restockOrderId  String   @db.Uuid
  receivedBy      String
  idempotencyKey  String   @unique
  notes           String?
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  restockOrder RestockOrder        @relation(fields: [restockOrderId], references: [id], onDelete: Cascade)
  items        RestockReceiptItem[]

  @@index([restockOrderId])
}

model RestockReceiptItem {
  id                  String  @id @default(uuid()) @db.Uuid
  receiptId           String  @db.Uuid
  restockOrderItemId  String  @db.Uuid
  productId           String  @db.Uuid
  quantityGood        Int
  quantityDamaged     Int     @default(0)
  quantityBonus       Int     @default(0)
  purchasePrice       Decimal @db.Decimal(12, 2)
  unitName            String
  piecesPerUnit       Int
  notes               String?

  receipt        RestockReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  restockOrderItem RestockOrderItem @relation(fields: [restockOrderItemId], references: [id], onDelete: Restrict)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([restockOrderItemId])
}

model InventoryCheck {
  id          String               @id @default(uuid()) @db.Uuid
  checkNumber String               @unique
  checkedBy   String
  status      InventoryCheckStatus @default(DRAFT)
  notes       String?
  checkedAt   DateTime             @default(now())
  createdAt   DateTime             @default(now())

  items InventoryCheckItem[]

  @@index([checkedAt])
}

model InventoryCheckItem {
  id               String @id @default(uuid()) @db.Uuid
  inventoryCheckId String @db.Uuid
  productId        String @db.Uuid
  systemStock      Int
  physicalStock    Int
  difference       Int
  reason           String
  notes            String?

  inventoryCheck InventoryCheck @relation(fields: [inventoryCheckId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([inventoryCheckId])
  @@index([productId])
}
